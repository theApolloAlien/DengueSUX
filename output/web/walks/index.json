  "formula": {
    "label": "Walk order / 100 (assumed operational rule, not a prediction)",
    "expression": "min(100, place type + compactness + homes nearby)",
    "place_type": {
      "cap": 25,
      "weights": {
        "block": 25.0,
        "hawker": 20.0,
        "park": 15.0
      }
    },
    "compactness": {
      "cap": 35,
      "expression": "35 × max(0, 1 − distance to the walk centre / 350 m)"
    },
    "homes": {
      "cap": 40,
      "expression": "40 × min(HDB homes within 150 m / 1,500, 1)"
    },
    "missing": "No case counts are used. Places without a verified location are left out, never estimated."
  },
  "landuse_note": "URA Master Plan 2025 zoning (planned use): parks and open space in green, water bodies in blue.",
  "footprint_note": "Official HDB footprints. Estimated height = published max_floor_lvl × 2.8 m + 1.3 m roof allowance (the NUS Urban Analytics Lab HDB 3D convention), not a surveyed height. Blocks without a verified storey count stay flat. Non-HDB buildings (role 'city') are grey context from Overture Maps (OpenStreetMap, Microsoft, Google and Esri footprints), raised only where a height or floor count is listed; they never replace an HDB shape. Places to check, not confirmed breeding sites.",
  "method": {
    "storey_height_m": 2.8,
    "roof_allowance_m": 1.3,
    "context_margin_m": 160,
    "height_reference": "Biljecki (2020), NUS Urban Analytics Lab hdb3d: 2.8 m floor-to-floor + 1.3 m roof",
    "coordinate_rounding": "7 decimal places (about 1 cm)",
    "city_context": "Overture Maps buildings (OpenStreetMap, Microsoft, Google, Esri) within the same margin as context, not data: grey, raised only from a listed height or floor count, dropped where an HDB footprint covers them",
