{
 "datasets": [
  {
   "name": "ds_today",
   "displayName": "Today",
   "queryLines": [
    "SELECT s.clusters, s.people, s.large_clusters, s.snapshot_date,\n",
    "       (SELECT count(*) FROM gold_area_forecast WHERE band = 'High') AS areas_high_in_two_weeks,\n",
    "       (SELECT count(*) FROM gold_area_forecast WHERE band = 'High' AND band_now <> 'High') AS new_hotspots,\n",
    "       (SELECT datediff(current_date(), max(week_end)) FROM silver_national_weekly) AS label_age_days\n",
    "FROM gold_daily_cluster_summary s\n",
    "WHERE s.snapshot_date = (SELECT max(snapshot_date) FROM gold_daily_cluster_summary)\n"
   ]
  },
  {
   "name": "ds_outlook",
   "displayName": "Two-week area outlook",
   "queryLines": [
    "SELECT area_name, band_now, band, p_any, p_high, people_now, clusters_now, top_driver, as_of\n",
    "FROM gold_area_forecast\n",
    "WHERE p_any >= 0.1 OR band <> 'Low'\n",
    "ORDER BY p_high DESC\n"
   ]
  },
  {
   "name": "ds_national",
   "displayName": "National forecast vs reported",
   "queryLines": [
    "SELECT CAST(target_week_end AS DATE) AS week_end, actual AS reported, round(selected_prediction, 1) AS forecast,\n",
    "       round(lower, 1) AS range_low, round(upper, 1) AS range_high, round(baseline, 1) AS four_week_average\n",
    "FROM gold_national_predictions\n",
    "WHERE segment IN ('prospective', 'live') AND CAST(target_week_end AS DATE) >= date_sub(current_date(), 400)\n",
    "ORDER BY week_end\n"
   ]
  },
  {
   "name": "ds_ledger",
   "displayName": "Published forecasts",
   "queryLines": [
    "SELECT kind, target, CAST(published_at AS TIMESTAMP) AS published_at, prediction, lower, upper, actual, covered, abs_error, model_version\n",
    "FROM gold_forecast_ledger WHERE kind = 'national' ORDER BY target\n"
   ]
  },
  {
   "name": "ds_bench_summary",
   "displayName": "Benchmark summary",
   "queryLines": [
    "SELECT 'DengueSUX model' AS forecaster, round(avg(abs(actual - denguesux)), 1) AS mean_abs_error FROM gold_ai_forecast_benchmark\n",
    "UNION ALL SELECT 'Four-week average', round(avg(abs(actual - four_week_average)), 1) FROM gold_ai_forecast_benchmark\n",
    "UNION ALL SELECT 'Databricks ai_forecast', round(avg(abs(actual - ai_forecast)), 1) FROM gold_ai_forecast_benchmark\n"
   ]
  },
  {
   "name": "ds_bench",
   "displayName": "Benchmark by week",
   "queryLines": [
    "SELECT target_week_end, actual AS reported, denguesux, four_week_average, ai_forecast FROM gold_ai_forecast_benchmark ORDER BY target_week_end\n"
   ]
  },
  {
   "name": "ds_daily",
   "displayName": "Daily clusters",
   "queryLines": [
    "SELECT snapshot_date, clusters, people, large_clusters, people_change FROM gold_daily_cluster_summary ORDER BY snapshot_date\n"
   ]
  },
  {
   "name": "ds_history",
   "displayName": "Areas with clusters since 2019",
   "queryLines": [
    "SELECT date, count(DISTINCT area_code) AS areas_with_clusters FROM silver_area_cluster_history WHERE clusters > 0 GROUP BY date ORDER BY date\n"
   ]
  },
  {
   "name": "ds_outcomes",
   "displayName": "Field outcomes",
   "queryLines": [
    "SELECT area_code, place_type, reports, stops_reported, water_found_reports, cleared_reports, last_reported_at FROM gold_field_outcomes ORDER BY last_reported_at DESC\n"
   ]
  }
 ],
